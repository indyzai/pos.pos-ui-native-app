{
  "expo": {
    "name": "IndyzAI POS",
    "slug": "indyz-pos",
    "version": "1.0.0",
    "scheme": "indyzai-pos",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow IndyzAI POS to use your camera to scan barcodes and QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow IndyzAI POS to use Face ID to unlock your POS session."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111318",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Allow IndyzAI to discover and print to nearby Bluetooth label and receipt printers.",
        "NSLocalNetworkUsageDescription": "Allow IndyzAI to send receipts and labels to printers on your local network."
      },
      "bundleIdentifier": "com.indyzai.pos.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.indyzai.pos.app",
      "adaptiveIcon": {
        "backgroundColor": "#3548B8",
        "foregroundImage": "./assets/android-icon-foreground-safe.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
