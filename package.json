{
  "name": "pos.pos-ui-native-app",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {},
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.2",
    "expo": "~57.0.20",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "bun run --filter @indyzai/pos-mobile start",
    "start:both": "bun run --filter @indyzai/pos-mobile --filter @indyzai/admin-mobile start",
    "android": "bun run --filter @indyzai/pos-mobile android",
    "ios": "bun run --filter @indyzai/pos-mobile ios",
    "admin:start": "bun run --filter @indyzai/admin-mobile start",
    "admin:android": "bun run --filter @indyzai/admin-mobile android",
    "admin:ios": "bun run --filter @indyzai/admin-mobile ios",
    "both": "bun run --filter @indyzai/pos-mobile --filter @indyzai/admin-mobile start",
    "test": "bun test",
    "typecheck": "bun x tsc -p packages/tsconfig.json --noEmit && bun x tsc -p apps/pos-mobile/tsconfig.json --noEmit && bun x tsc -p apps/admin-mobile/tsconfig.json --noEmit",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check"
  },
  "private": true
}
